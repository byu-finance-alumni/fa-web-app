# Copy this file to .env.local and fill in real values.
# Only NEXT_PUBLIC_* variables are exposed to the browser — never put secrets here.

# Base URL of the FastAPI backend
NEXT_PUBLIC_API_URL=

# Supabase project URL and publishable (client-safe) key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
