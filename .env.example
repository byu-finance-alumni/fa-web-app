# Copy this file to .env.local and fill in real values.
# Only NEXT_PUBLIC_* variables are exposed to the browser — never put secrets here.

# Deployment URLs (reference):
#   This app  — prod: https://finance-alumni-database.vercel.app/  dev: https://dev-fa-web-app.vercel.app/
#   Backend   — prod: https://fa-web-api.vercel.app/               dev: https://dev-fa-web-api.vercel.app/

# Base URL of the FastAPI backend
# Local: http://localhost:8000 | Prod: https://fa-web-api.vercel.app | Dev: https://dev-fa-web-api.vercel.app
NEXT_PUBLIC_API_URL=

# Supabase project URL and publishable (client-safe) key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
