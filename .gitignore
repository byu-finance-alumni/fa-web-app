npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep secrets out of git)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Claude Code — agents and local settings stay out of git
.claude/

# Throwaway test / scratch artifacts — never commit (dev promotes to prod with real data)
TEST_*
SCRATCH*
DRAFT_*
*.scratch
.board-seed*
*DO_NOT_MERGE*
