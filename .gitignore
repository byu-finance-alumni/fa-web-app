# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep secrets out of git)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Claude Code — agents and local settings stay out of git
.claude/

# Throwaway test / scratch artifacts — never commit (dev promotes to prod with real data).
# Anchored to the repo root with a leading slash so they never match the real
# lowercase tests/ suite (git is case-insensitive on Windows: TEST_* would match test_*).
/TEST_*
/SCRATCH*
/DRAFT_*
/.board-seed*
*.scratch
*DO_NOT_MERGE*
